{
  "name": "@qaytarme/realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:legacy": "tsx src/migrate-legacy.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "jose": "^6.1.0",
    "mongoose": "^8.24.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3"
  }
}
